# ============================================================
# SECRETS — never commit these
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
# Any variant: a .broken or .bak left beside one of these is still an
# SMTP configuration, and a stray `git add .` must not pick it up.
smtp_config*.json
smtp_config*.json.*
smtp_counters.json
organizer_credentials.json
client_secret*.json
token.json
credentials.json

# ============================================================
# EVENT DATA (contains attendee PII — names, emails, codes)
# ============================================================
coupons.csv
coupons*.csv
responses*.csv
*.csv.backup*
coupons_backup.db*
sample_attendees.csv
test_attendees.csv
dcs_*.csv
uploads/
backups/
archive/
exports/
logs/
Farewell Party*/
Freshers*/

# Databases. The -wal and -shm sidecars hold recently written rows and do NOT
# match *.db, so without them attendee data reaches a commit.
data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sql

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
pip-selfcheck.json
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ============================================================
# Tooling / editors / OS
# ============================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.kiro/
.claude/

# ============================================================
# Runtime
.server.pid

# Tunnels
# ============================================================
ngrok
ngrok.exe
ngrok.log
