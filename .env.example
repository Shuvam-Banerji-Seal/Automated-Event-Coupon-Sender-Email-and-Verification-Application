# ============================================================
# 21MS FAREWELL PARTY - AUTOMATED COUPON SYSTEM
# IISER Kolkata | 22MS Organizers
# ============================================================

# Flask Configuration
SECRET_KEY=your-super-secret-key-minimum-32-characters-long
FLASK_DEBUG=True
PORT=5000

# Coupon Encryption Key (REQUIRED - Generate with the command below)
# Generate with: /home/shuvam/.global-pymaster/bin/python -c "import secrets; print(secrets.token_hex(32))"
# Example: COUPON_SECRET_KEY=a1b2c3d4e5f6... (64 hex characters)
COUPON_SECRET_KEY=CHANGE_ME_generate_with_command_above

# ============================================================
# SMTP EMAIL CONFIGURATION
# This branch uses SMTP instead of Gmail API
# ============================================================

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# Sender Gmail Account (the 22MS organizer's Gmail)
SMTP_USERNAME=your-22ms-organizer-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password

# Display name in emails
SMTP_SENDER_NAME=22MS Batch, IISER Kolkata
SMTP_SENDER_EMAIL=your-22ms-organizer-email@gmail.com

# ============================================================
# EVENT CONFIGURATION
# ============================================================

EVENT_NAME=21MS Farewell Party
EVENT_DATE=To Be Announced
EVENT_VENUE=IISER Kolkata Campus
EVENT_TIME=To Be Announced

# ============================================================
# TEST EMAIL ADDRESSES
# Used ONLY for test_smtp_connection.py and send_test_emails.py
# ============================================================

TEST_EMAIL_1=first-test-email@example.com
TEST_EMAIL_2=second-test-email@example.com
TEST_EMAIL_3=third-test-email@example.com

# ============================================================
# GOOGLE OAUTH (Optional - for organizer login only)
# Leave blank if not using OAuth login
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback