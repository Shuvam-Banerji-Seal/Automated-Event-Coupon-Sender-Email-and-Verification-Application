# ============================================================
# Event Coupon System — configuration
#
# Copy to .env and fill in. .env is gitignored; never commit it.
# ============================================================

# --- Required --------------------------------------------------------------

# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Encrypts the coupon payload stored alongside each record. Generate the same
# way. Changing it after coupons are issued makes existing payloads unreadable.
COUPON_SECRET_KEY=

# --- Server ----------------------------------------------------------------

PORT=5000

# Phone cameras only work over https. Browsers block getUserMedia on a plain
# http origin that is not localhost, so the scanner cannot use the camera
# without this. Generate a self-signed pair with:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365
SSL_ENABLED=true

FLASK_DEBUG=false
LOG_LEVEL=INFO

# Where the database lives.
DATABASE_PATH=data/coupons.db

# --- Access ----------------------------------------------------------------

# PIN volunteers type once per phone before they can scan. Without it, anyone
# who can reach this machine on the network can redeem coupons. Set it.
SCANNER_PIN=

# The console is restricted to this machine. Set to true only if you genuinely
# need to administer it from another device on the network.
DISABLE_ADMIN_CHECK=false

# Extra addresses allowed into the console, comma separated.
ADMIN_EXTRA_IPS=

# Only enable behind a reverse proxy you control — it makes the app believe
# X-Forwarded-For, which any client can otherwise forge.
TRUST_PROXY=false

# Scan attempts allowed per address per window. Generous on purpose: behind a
# tunnel every phone shares one source address.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=60

# --- Event defaults --------------------------------------------------------
# These seed the Settings page; edit them there afterwards.

EVENT_NAME=Our Event
EVENT_DATE=To be announced
EVENT_TIME=To be announced
EVENT_VENUE=To be announced
ORGANIZER_BATCH=
ORGANIZER_INSTITUTION=IISER Kolkata

# --- Mail ------------------------------------------------------------------
# Optional. Accounts added through Settings are stored in smtp_configs.json
# and take precedence; this is the fallback for a first run.
#
# Gmail needs an App Password (myaccount.google.com -> App passwords), not
# your normal password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=

# Suppress delivery entirely: messages are rendered, logged and counted but
# never handed to an SMTP server. Turn this ON while testing — a populated
# .env is all it takes for an exploratory run to send real mail.
MAIL_DRY_RUN=false

# --- Public address (zrok) -------------------------------------------------
# Publishes the scanner on the internet with a real certificate, so phone
# cameras work without joining the venue wifi or accepting a warning. Only
# scanner routes are served publicly; the console stays local.
#
# One-time setup on this machine:
#   zrok enable <your-account-token>
# Then use "Go live" in Settings. A SCANNER_PIN is required before publishing.

# --- Thank-you mail --------------------------------------------------------
# Template sent automatically when a guest checks in. Blank disables it.
THANK_YOU_TEMPLATE=thank_you
# Seconds between queued messages.
OUTBOX_THROTTLE=0.5

# --- Scanner rate limiting -------------------------------------------------
# Only lookups that match nothing count toward this, so a busy door is never
# throttled while code-guessing is stopped quickly. Keyed per device.
SCAN_FAIL_MAX=20
SCAN_FAIL_WINDOW=300
SCAN_GLOBAL_MAX=3000
SCAN_GLOBAL_WINDOW=60

# Fixed public address for the scanner: https://<name>.shares.zrok.io
# Reserved once on your zrok account; the same address comes back after every
# restart, so a link handed out in advance keeps working. Leave blank to get a
# new random address each time the tunnel starts.
ZROK_RESERVED_NAME=

# Reopen the public share automatically when the application starts. Off by
# default — publishing to the internet is normally a deliberate click — but
# worth turning on for an event, so a reboot does not leave volunteers holding
# a dead link. Requires SCANNER_PIN.
ZROK_AUTOSTART=false

# Rotate logs/server.log and logs/zrok.log at startup once they exceed this.
LOG_MAX_BYTES=8388608

# Stored times are UTC. This is the zone they are displayed in — the
# thank-you mail tells an attendee when they were scanned, and 07:40 for a
# 13:10 lunch is worse than saying nothing.
EVENT_TIMEZONE=Asia/Kolkata
